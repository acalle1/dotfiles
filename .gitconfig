[user]
	email = calleandersson2505@gmail.com
	name = acalle
[init]
	defaultBranch = master
[core]
	editor = nvim
	pager = "less -FX"
[pull]
	rebase = true
[diff]
	tool = nvimdiff
    	guitool = nvimdiff
[merge]
    	tool = nvimdiff
    	conflictstyle = diff3
[mergetool]
    	keepBackup = false
    	trustExitCode = false
	prompt = true
[difftool]
    	prompt = false
[mergetool "nvimdiff"]	
    	layout = LOCAL,MERGED,REMOTE
