# Font setup for icons and readability
font-family = Iosevka Fixed
font-family = JetBrainsMono Nerd Font

# typography
font-size=16
font-thicken=true
font-thicken-strength=1
adjust-cell-height=1

# Best theme ever
theme = TokyoNight

# For transparency
background-opacity = 1.0

# Cursor preferences
cursor-style = "block"
cursor-style-blink = true
shell-integration-features = "no-cursor"
mouse-hide-while-typing = true
window-save-state = always

# Window size and padding
window-width = 115
window-height = 45
window-padding-y = 0,1
window-padding-x = 1,1

gtk-titlebar = false

# Send Ctrl+W for Ctrl+Backspace so word-delete works in apps that don't
# use Readline (e.g. Claude Code), not just the shell
keybind = ctrl+backspace=text:\x17
